<UserControl x:Class="CoreMeld.UI.Desktop.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Background="#EEFAFF"
             d:DesignHeight="900" d:DesignWidth="1440">

    <UserControl.Resources>
        <Style x:Key="CategoryDot" TargetType="Ellipse">
            <Setter Property="DockPanel.Dock" Value="Left"/>
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CategoryName" TargetType="TextBox" BasedOn="{StaticResource SelectableSection}">
            <Setter Property="DockPanel.Dock" Value="Left"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PriceText" TargetType="TextBox" BasedOn="{StaticResource SelectableSection}">
            <Setter Property="DockPanel.Dock" Value="Right"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RefreshButton" TargetType="Button">
            <Setter Property="DockPanel.Dock" Value="Right"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource RefreshBrush}"/>
            <Setter Property="Margin" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <Viewbox Width="30" Height="30">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{TemplateBinding Foreground}"
                                  Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComponentName" TargetType="TextBox" BasedOn="{StaticResource SelectableText}">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BarSegment" TargetType="Button">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" Background="{TemplateBinding Background}"
                                CornerRadius="{Binding CornerRadius}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="Background" Value="#DDF1FA"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="117,0,0,0">
                <Button Style="{StaticResource BackButton}" ToolTip="Назад" Command="{Binding BackCommand}"/>
                <TextBlock Text="COREMELD" Style="{StaticResource LogoTitle}" Margin="16,0,0,0"/>
                <TextBlock Text="PC CONFIGURATOR" Style="{StaticResource LogoSubtitle}"
                           VerticalAlignment="Bottom" Margin="10,0,0,4"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="White" MaxWidth="1230" Margin="30,40,30,50" Padding="40,36,40,40">
                <StackPanel>

                    <TextBox Text="Конфігурація готова!" Style="{StaticResource SelectablePageTitle}"/>

                    <Border Width="583" Height="10" Margin="0,16,0,6">
                        <ItemsControl ItemsSource="{Binding BudgetSegments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource BarSegment}"
                                        Width="{Binding Width}"
                                        Background="{Binding Color}"
                                        ToolTip="{Binding ToolTipText}"
                                        ToolTipService.InitialShowDelay="0"
                                        ToolTipService.ShowDuration="15000"
                                        Command="{Binding DataContext.HighlightCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Category}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBox Text="{Binding BudgetCaption, Mode=OneWay}" Style="{StaticResource SelectableText}"
                         FontSize="11" HorizontalAlignment="Center" TextAlignment="Center"/>

                    <ItemsControl Margin="0,36,0,20" ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowCard}">
                                    <DockPanel Height="72">
                                        <Ellipse Fill="{Binding Color}" Style="{StaticResource CategoryDot}"/>
                                        <TextBox Text="{Binding CategoryName, Mode=OneWay}" ToolTip="{Binding Hint}"
                                             ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="15000"
                                             Style="{StaticResource CategoryName}"/>

                                        <TextBox Text="{Binding PriceText, Mode=OneWay}" Style="{StaticResource PriceText}"/>
                                        <Button Style="{StaticResource RefreshButton}" ToolTip="Замінити деталь"
                                            Command="{Binding DataContext.ReplaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Category}"/>
                                        <TextBox Text="{Binding Name, Mode=OneWay}" Style="{StaticResource ComponentName}"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Скопіювати конфігурацію" Style="{StaticResource PrimaryButton}"
                        FontSize="16" Padding="44,12" HorizontalAlignment="Center"/>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>