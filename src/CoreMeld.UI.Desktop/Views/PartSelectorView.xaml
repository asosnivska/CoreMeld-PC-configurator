<UserControl x:Class="CoreMeld.UI.Desktop.Views.PartSelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Background="White"
             d:DesignHeight="900" d:DesignWidth="1440">

    <UserControl.Resources>
        <Style x:Key="FilterTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style x:Key="CharText" TargetType="TextBlock">
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="ItemName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="PriceText" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="SelectButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="ChevronToggle" TargetType="ToggleButton">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="14,0,20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Path x:Name="Arrow" Data="M 0 0 L 6 6 L 12 0" Stroke="Black" StrokeThickness="2"
                              Margin="4" Fill="Transparent"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Data" Value="M 0 6 L 6 0 L 12 6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ItemExpander" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <!-- Click anywhere on the header row to expand/collapse -->
                            <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Cursor="Hand" Background="Transparent" BorderThickness="0"
                                          HorizontalContentAlignment="Stretch" Padding="6,12">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header"/>
                            </ToggleButton>
                            <ContentPresenter ContentSource="Content" x:Name="Body"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="Body" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="37,0,0,0">
                    <Button Style="{StaticResource BackButton}" ToolTip="Назад" Command="{Binding BackCommand}"/>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="COREMELD" Style="{StaticResource LogoTitle}" FontSize="22"/>
                        <TextBlock Text="PC CONFIGURATOR" Style="{StaticResource LogoSubtitle}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding CategoryTitle}" Style="{StaticResource PageTitle}"
                           Foreground="White" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <Border Width="220" Height="33" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,40,0" Background="White" CornerRadius="4">
                    <Grid>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 Padding="8,0" Foreground="#222" BorderThickness="0" Background="Transparent"/>
                        <TextBlock Text="Пошук..." IsHitTestVisible="False" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Foreground="Gray" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Filters -->
            <Border Grid.Column="0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0" Background="#FAFAFA">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,10,20,24">

                        <TextBlock Text="Ціна:" Style="{StaticResource FilterTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBox Width="75" Height="26" Text="{Binding MinPriceText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" Padding="4,0"/>
                            <TextBlock Text="—" VerticalAlignment="Center" Margin="6,0"/>
                            <TextBox Width="75" Height="26" Text="{Binding MaxPriceText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" Padding="4,0"/>
                            <TextBlock Text="UAH" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="Gray"/>
                        </StackPanel>

                        <TextBlock Text="Сортування:" Style="{StaticResource FilterTitle}"/>
                        <ComboBox SelectedIndex="{Binding SelectedSortIndex}" Height="28">
                            <ComboBoxItem Content="від дешевих"/>
                            <ComboBoxItem Content="від дорожчих"/>
                        </ComboBox>

                        <TextBlock Text="Виробники:" Style="{StaticResource FilterTitle}"/>
                        <ItemsControl ItemsSource="{Binding BrandFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,3"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Застосувати" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ApplyFiltersCommand}"
                                Padding="20,7" FontSize="13" Margin="0,24,0,6"/>

                        <Button Content="Скинути фільтри" Command="{Binding ResetFiltersCommand}"
                                Background="Transparent" Foreground="#666" BorderThickness="0"
                                Cursor="Hand" FontSize="12" Margin="0,4,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Main Items Area -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="25,16,40,40">

                    <!-- Error banner if any -->
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6"
                            Margin="0,0,0,16" Padding="14,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button Content="Повторити" Command="{Binding RetryCommand}"
                                    DockPanel.Dock="Right" Padding="10,3" Margin="10,0,0,0"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="13"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Loading state -->
                    <TextBlock Text="Завантаження компонентів..." FontSize="16" Foreground="Gray"
                               HorizontalAlignment="Center" Margin="0,40,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Top Selected Component (Pinned at top, NO Select Button) -->
                    <ContentControl Content="{Binding CurrentItem}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentItem}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <Expander Style="{StaticResource ItemExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="105"/>
                                                    <ColumnDefinition Width="105"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource ItemName}"/>
                                                <ToggleButton Grid.Column="1" Style="{StaticResource ChevronToggle}"
                                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Expander}}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding PriceText}" Style="{StaticResource PriceText}"/>
                                                <!-- Empty column 3 keeps alignment identical to items with "Обрати" button -->
                                            </Grid>
                                        </Expander.Header>
                                        
                                        <!-- Characteristics with alternating zebra rows -->
                                        <Border Margin="10,0,0,10" Background="Transparent">
                                            <ItemsControl ItemsSource="{Binding Characteristics}" AlternationCount="2">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="RowBorder" Padding="12,5" CornerRadius="2">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="260"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource CharText}" FontWeight="SemiBold" Foreground="#444444"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource CharText}" Foreground="#222222"/>
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                                                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource StripeBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                                <Setter TargetName="RowBorder" Property="Background" Value="Transparent"/>
                                                            </Trigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Expander>

                                    <!-- Subtle separation line between currently selected item and alternatives -->
                                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,6,0,10"/>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                    <!-- Empty state -->
                    <TextBlock Text="Компонентів не знайдено за заданими фільтрами" FontSize="16" Foreground="Gray"
                               HorizontalAlignment="Center" Margin="0,30,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsEmpty}" Value="True"/>
                                            <Condition Binding="{Binding IsLoading}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- List of alternative components (with "Обрати" button) -->
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Style="{StaticResource ItemExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="105"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource ItemName}"/>
                                            <ToggleButton Grid.Column="1" Style="{StaticResource ChevronToggle}"
                                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Expander}}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding PriceText}" Style="{StaticResource PriceText}"/>
                                            <Button Grid.Column="3" Content="Обрати" Style="{StaticResource SelectButton}"
                                                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Expander.Header>

                                    <!-- Characteristics with alternating zebra rows -->
                                    <Border Margin="10,0,0,10" Background="Transparent">
                                        <ItemsControl ItemsSource="{Binding Characteristics}" AlternationCount="2">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="RowBorder" Padding="12,5" CornerRadius="2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="260"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource CharText}" FontWeight="SemiBold" Foreground="#444444"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource CharText}" Foreground="#222222"/>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource StripeBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="Transparent"/>
                                                        </Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
